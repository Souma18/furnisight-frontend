# API base (axios)
VITE_API_BASE_URL=/api

# MessageService REST prefix through gateway
VITE_MESSAGE_SERVICE_PREFIX=/messages

# Optional direct base URL if you do not want to rely on Vite proxy
VITE_MESSAGE_SERVICE_BASE_URL=

# WebSocket STOMP endpoint (SockJS)
# Dev qua gateway/proxy: http://localhost:5173/messages/ws
# Trực tiếp BE: http://localhost:8085/ws
VITE_MESSAGE_WS_URL=http://localhost:5173/messages/ws

# Mock user IDs until gateway decodes JWT (TODO: remove after auth integration)
VITE_CHAT_BUYER_ID=1001
VITE_CHAT_STAFF_ID=5001


# Example of using Vite environment variables in code:
VITE_MESSAGE_SERVICE_BASE_URL=http://localhost:8085
VITE_MESSAGE_SERVICE_PREFIX=
VITE_MESSAGE_WS_URL=http://localhost:8085/ws
